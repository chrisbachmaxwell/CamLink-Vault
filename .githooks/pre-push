#!/bin/sh
set -eu

zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are blocked for the Med Photo Vault." >&2
    echo "Push a feature branch and merge it through a PR." >&2
    exit 1
  fi
  if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ]; then
    if git cat-file -e "$remote_sha^{commit}" 2>/dev/null &&
       ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "Non-fast-forward push blocked for $remote_ref." >&2
      exit 1
    fi
  fi
done

exit 0
